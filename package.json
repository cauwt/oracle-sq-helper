{
  "name": "oracle-sql-helper",
  "displayName": "Oracle SQL Helper",
  "description": "Helper for Oracle SQL",
  "publisher": "cauwt",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:oracle-sql"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cauwt/oracle-sql-helper.git"
  },
  "license": "MIT",
  "icon": "images/icon.png",
    "contributes": {
    "languages": [
	    {
        "id": "oracle-sql",
        "aliases": [
          "PL/SQL"
        ],
        "extensions": [
          ".pro"
        ],
        "configuration": "./language-configuration.json"
      }

    ],
    "grammars": [
      {
        "language": "oracle-sql",
        "scopeName": "source.oracle-sql",
        "path": "./syntaxes/oracle-sql.tmLanguage.plist"
      }
    ],
    "commands": [
      {
        "command": "sql.formatComments",
        "title": "格式化单行注释"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "sql.formatComments",
          "group": "1_modification",
          "when": "editorLangId == oracle-sql"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "moo": "^0.5.2",
    "nearley": "^2.20.1"
  },
  "devDependencies": {
    "@types/moo": "^0.5.0",
    "@types/nearley": "^2.11.0",
    "@types/node": "^25.9.2",
    "@types/vscode": "^1.100.0",
    "typescript": "^5.0.0"
  }
}
