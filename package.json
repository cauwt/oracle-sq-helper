{
  "name": "oracle-sql-helper",
  "displayName": "Oracle SQL Helper",
  "description": "Helper for Oracle SQL",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:sql",
    "onLanguage:oracle-sql"
  ],
  "contributes": {
    "languages": [
      {
        "id": "sql",
        "aliases": [
          "SQL",
          "sql"
        ],
        "extensions": [
          ".sql"
        ],
        "configuration": "./language-configuration.json"
      },
	        {
        "id": "oracle-sql",
        "aliases": [
          "PL/SQL"
        ],
        "extensions": [
          ".pro"
        ],
        "configuration": "./language-configuration.json"
      }

    ],
    "grammars": [
      {
        "language": "sql",
        "scopeName": "source.sql",
        "path": "./syntaxes/sql.tmLanguage.json"
      },
      {
        "language": "oracle-sql",
        "scopeName": "source.oracle-sql",
        "path": "./syntaxes/oracle-sql.tmLanguage.plist"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "moo": "^0.5.2",
    "nearley": "^2.20.1"
  },
  "devDependencies": {
    "@types/moo": "^0.5.0",
    "@types/nearley": "^2.11.0",
    "@types/node": "^25.9.2",
    "@types/vscode": "^1.100.0",
    "typescript": "^5.0.0"
  }
}
